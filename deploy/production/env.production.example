# Replace the hostname and private IP before starting. Generate both secrets.
SERSI_SECRET_KEY=
POSTGRES_PASSWORD=
SERSI_BIND_ADDRESS=192.168.50.20
SERSI_PORT=80
SERSI_HTTPS_PORT=443
SERSI_ALLOWED_HOSTS=notices.entreprise.example
SERSI_TRUSTED_ORIGINS=https://notices.entreprise.example
SERSI_HTTPS=1
SERSI_BACKUP_STORAGE=/srv/sersi-notices/archives
SERSI_PRODUCTION_CONFIG_DIR=/srv/sersi-notices/config
COMPOSE_PROJECT_NAME=sersi-notice-web
COMPOSE_FILE=/srv/sersi-notices/app/compose.yaml:/srv/sersi-notices/config/compose.production.yaml
