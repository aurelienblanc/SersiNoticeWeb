# Copier dans .env puis remplacer les deux valeurs ci-dessous par des secrets aléatoires distincts.
SERSI_SECRET_KEY=
POSTGRES_PASSWORD=

# Laisser 127.0.0.1 pour les premiers essais. Pour le LAN, saisir l’IP interne du serveur.
# Exemple : SERSI_BIND_ADDRESS=192.168.1.20
SERSI_BIND_ADDRESS=127.0.0.1
SERSI_PORT=8080
# Hôtes exacts, séparés par des virgules, sans protocole ni port.
SERSI_ALLOWED_HOSTS=localhost,127.0.0.1
# Exemple LAN : http://192.168.1.20:8080,http://notice.sersi.local:8080
SERSI_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Activer seulement après configuration du HTTPS sur le proxy (voir README.md).
SERSI_HTTPS=0

# Volume Docker dédié, ou chemin absolu d’un dossier serveur/NAS monté.
# Le dossier doit être accessible en écriture à l’UID 10001.
# Exemple : SERSI_BACKUP_STORAGE=/srv/sauvegardes/sersi-notice
SERSI_BACKUP_STORAGE=archives
